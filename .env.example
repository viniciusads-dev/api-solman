# Obrigatório. Raiz do serviço OData, sem coleção, chave ou parâmetros.
# Exemplo fictício: https://sap.example.com/sap/opu/odata/SAP/NOME_DO_SERVICO
# Preencha quando a equipe SAP informar o serviço definitivo.
SAP_SERVICE_URL=

# Preencha se o Basis confirmar o mandante usado pela integração.
SAP_CLIENT=

# Para Basic, preencha usuário e senha da conta técnica de leitura.
SAP_USERNAME=
SAP_PASSWORD=

# Para autenticação Bearer, preencha só este campo.
SAP_BEARER_TOKEN=

# Opcional. Caminho do certificado CA corporativo em formato PEM.
SAP_CA_FILE=
SAP_TIMEOUT_SECONDS=15

# Obrigatório. Nome da coleção unificada publicado no $metadata (sem caminho).
# A API usa a chave em ChamadoUnificadoSet('NUMERO') e recebe o chamado em um GET.
SAP_CHAMADOS_ENTITY_SET=ChamadoUnificadoSet

# Token entre o app e esta API. Vazio permite testar no localhost.
API_TOKEN=
