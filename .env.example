# Raiz do serviço OData DEV, sem nome de coleção nem parâmetros na URL.
SAP_SERVICE_URL=https://sap.example.com/sap/opu/odata/SAP/ZCHAMADOS_DEMO_SRV

# Preencha se o Basis confirmar o mandante usado pela integração.
SAP_CLIENT=

# Para Basic, preencha usuário e senha da conta técnica de leitura.
SAP_USERNAME=
SAP_PASSWORD=

# Para autenticação Bearer, preencha só este campo.
SAP_BEARER_TOKEN=

# Opcional. Caminho do certificado CA corporativo em formato PEM.
SAP_CA_FILE=
SAP_TIMEOUT_SECONDS=15

# Nomes publicados no SAP Gateway, com a mesma grafia do $metadata.
SAP_CHAMADOS_ENTITY_SET=ChamadoSet
SAP_DETAILS_ENTITY_SET=DetalheChamadoSet

# Token entre o app e esta API. Vazio permite testar no localhost.
API_TOKEN=
